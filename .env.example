# Public address of the shop (used in links, sitemap and e-mails)
NEXT_PUBLIC_SITE_URL=https://omaya.bg

# Where orders are saved (orders.jsonl). Keep it OUTSIDE the project folder.
DATA_DIR=../omaya-data

# E-mail for new orders. Without SMTP the orders are only saved to DATA_DIR/orders.jsonl.
SHOP_EMAIL=poruchki@omaya.bg
MAIL_FROM="Омая <no-reply@omaya.bg>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Key for the "Създай товарителница" links in the order e-mails (any random text, 16+ characters).
WAYBILL_SECRET=

# Couriers (check with `npm run couriers`). Without a login a courier's offices are still listed at checkout and its
# waybills are made on the courier's own site.
SPEEDY_USERNAME=
SPEEDY_PASSWORD=
ECONT_USERNAME=
ECONT_PASSWORD=
BOXNOW_API_URL=
BOXNOW_CLIENT_ID=
BOXNOW_CLIENT_SECRET=
BOXNOW_WAREHOUSE_ID=
PIGEON_API_KEY=
PIGEON_API_SECRET=

# Sender on the waybills
SENDER_NAME=
SENDER_CONTACT=
SENDER_PHONE=
SENDER_EMAIL=
SENDER_CITY=
SENDER_POSTCODE=
SENDER_ADDRESS=
# Offices where parcels are handed in; empty = the courier collects them from the address above
SPEEDY_DROPOFF_OFFICE_ID=
ECONT_DROPOFF_OFFICE_CODE=
PIGEON_DROPOFF_OFFICE_ID=
